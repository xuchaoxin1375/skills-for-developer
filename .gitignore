# JS / Node
node_modules/

# Python
__pycache__/
*.py[cod]

# OS / editor junk
Thumbs.db
.DS_Store
*~
*.swp
tmp.*
temp.*
# PowerShell link script backups live next to harness dirs, not in repo;
# keep this as a safety net in case one is ever created here.
*.bak-*

# skill eval workspaces (skill-creator iteration artifacts: outputs/benchmark/review.html).
# Local-only: never committed, never synced across machines.
.workspaces/

# 第三方独立 clone 与共享实体；来源/版本/精选路径只登记到 config/。
# Matt clone: third-party/mattpocock-skills（不是 submodule，不提交实体或链接）。
# 实体与 .env 一律不入库；默认位置是 ~/.local/share/skills-for-developer/third-party/。
third-party/

# Codex local artifact: may regenerate <skill>/agents/openai.yaml at runtime.
# Keep it untracked; source of truth stays in SKILL.md.
**/agents/openai.yaml
