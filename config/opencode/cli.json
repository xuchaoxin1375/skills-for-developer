{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "permissions": "autoaccept",
    "image_preview": true,
    "verbosity": "high"
  },
  "animations": true,
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "image_preview": true
  },
  "tabs": {
    "layout": "vertical",
    "indicators": "numbers"
  },
  "debug": {
    "devtools": true,
    "turn_tokens": "verbose",
    "timing": false
  },
  "attention": {
    "notifications": false
  },
  "theme": {
    "mode": "system"
  }
}
