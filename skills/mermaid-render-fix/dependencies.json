{
  "schemaVersion": 1,
  "requirements": [
    {
      "id": "python",
      "required": true,
      "alternatives": [
        { "kind": "runtime", "name": "python", "minVersion": "3.9" },
        { "kind": "runtime", "name": "python3", "minVersion": "3.9" }
      ],
      "hint": "check_mermaid.py 与 render_mmd.py 仅用标准库，需要 Python 3.9+（Windows/Linux/macOS 通用）"
    },
    {
      "id": "renderer",
      "required": true,
      "alternatives": [
        { "kind": "command", "name": "mmdc" },
        { "kind": "command", "name": "pnpm" },
        { "kind": "command", "name": "npx" }
      ],
      "hint": "mmdc 优先；无 mmdc 时脚本经 pnpm/npx 临时拉起，首次需要联网"
    },
    {
      "id": "browser",
      "required": false,
      "kind": "browser",
      "hint": "脚本自动复用本机 Chrome/Edge/Chromium（含 Playwright 自带），免下载 Chromium；缺失时指定 -b/--browser 或 -p/--puppeteer-config"
    }
  ]
}
